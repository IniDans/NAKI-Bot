# Discord Bot Token — get from https://discord.com/developers/applications
DISCORD_TOKEN=

# Discord Application Client ID
CLIENT_ID=

# PostgreSQL connection string
# Local format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Cloud providers may require: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/naki_bot

# Optional: Node environment
NODE_ENV=development
