# Discord Bot Token - get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token

# Discord Application Client ID
CLIENT_ID=your_discord_application_client_id

# MySQL connection string (e.g. a cPanel database with Remote MySQL enabled for the bot's IP)
# Keep connection_limit low: shared hosting caps connections per user.
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=5

# Optional: Node environment
NODE_ENV=production

# Optional: public dashboard URL. When ban appeals are on, ban DMs link to DASHBOARD_URL/appeal/<server id>.
DASHBOARD_URL=https://dansyoung.my.id